+    public function testStaleSaveIsRejectedAndFirstSaveIsKept()
+    {
+        $projectModel = new ProjectModel($this->container);
+        $taskCreationModel = new TaskCreationModel($this->container);
+        $taskModificationModel = new TaskModificationModel($this->container);
+        $taskFinderModel = new TaskFinderModel($this->container);
+
+        $this->assertEquals(1, $projectModel->create(array('name' => 'test')));
+        $this->assertEquals(1, $taskCreationModel->create(array('title' => 'Before', 'project_id' => 1)));
+
+        // Both users opened the form at the same version
+        $loaded = (int) $taskFinderModel->getById(1)['date_modification'];
+
+        $this->assertTrue($taskModificationModel->update(array('id' => 1, 'title' => 'First'), true, $loaded));
+        $this->assertFalse($taskModificationModel->update(array('id' => 1, 'title' => 'Second'), true, $loaded));
+        $this->assertEquals('First', $taskFinderModel->getById(1)['title']);
+
+        // A form loaded after the first save can still save
+        $reloaded = (int) $taskFinderModel->getById(1)['date_modification'];
+        $this->assertTrue($taskModificationModel->update(array('id' => 1, 'title' => 'Third'), true, $reloaded));
+        $this->assertEquals('Third', $taskFinderModel->getById(1)['title']);
+    }
